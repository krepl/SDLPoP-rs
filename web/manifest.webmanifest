{
  "name": "SDLPoP",
  "short_name": "SDLPoP",
  "description": "Prince of Persia, ported to run natively in the browser via WebAssembly.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#222222",
  "theme_color": "#222222",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
