# PoP Hall of Fame file
PRINCE.HOF

# PoP saved game file
PRINCE.SAV
QUICKSAVE.SAV

# PoP recorded gameplay (replay)
*.P1R
*.p1r

# PoP custom levelsets
mods/*/

# Object files
*.o
*.ko
*.obj
*.elf

# Compiled resource files
*.res

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
prince
!data/PRINCE/

# Debug files
*.dSYM/

# Dev-C++
*.layout
Makefile.win
c/*_private.*

# CLion
.idea/
c/.idea/
c/cmake-build*/
build/

# Visual Studio
.vs/

# CMake
*CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Ninja
.ninja*
build.ninja

# Windows thumbnail cache
Thumbs.db

# The desktop file has to be recreated from the template.
c/SDLPoP.desktop

# backup files
*~

# Music files
data/music/*.ogg

# Screenshot saved from the game
screenshot.png
screenshots/

# Configuration file generated by the in-game settings menu
*.cfg

# Rust build output
target/

# wasm-bindgen output -- regenerated by scripts/build_wasm.sh, not checked in
web/pkg/

# Symlinks to project-root assets, recreated by scripts/build_wasm.sh so worker.js can
# fetch() them by a path relative to web/ (mirrors target/debug/{data,SDLPoP.ini} for the
# native harness).
web/data
web/SDLPoP.ini
web/data_manifest.txt

# Obsidian workspace
.obsidian/
tmp/

# Playwright MCP scratch output (screenshots/snapshots/console logs from browser checks)
.playwright-mcp/

__pycache__/

# Node deps for scripts/wasm_pixel_harness.mjs (Playwright driver for the wasm replay
# harness) -- reinstalled via `npm install`, not checked in.
node_modules/

# Scratch checkouts from Claude Code's isolation:"worktree" agent runs (real `git worktree`
# checkouts under .git/worktrees/, not just plain copies) -- not project state, never meant
# to be committed. Only hidden from `git status` here before this entry existed by a
# personal global gitignore rule, which doesn't help other contributors.
.claude/worktrees/
